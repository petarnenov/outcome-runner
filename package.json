{
  "name": "outcome-runner",
  "version": "0.25.1",
  "description": "Unattended OpenSpec outcome runner for the Git repository it is started in",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/petarnenov/outcome-runner.git" },
  "bin": { "outcome-runner": "dist/bin/outcome-runner.js" },
  "files": ["dist"],
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc",
    "release:dry-run": "node scripts/release.ts --dry-run",
    "test": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"scripts/*.test.ts\" --test-coverage-exclude=\"mascot/*.test.ts\" --test-coverage-lines=85 --test-coverage-branches=85 --test-coverage-functions=85 \"test/*.test.ts\" \"scripts/*.test.ts\" \"mascot/*.test.ts\"",
    "live:one": "LIVE_OUTCOME_ONE=1 node --test --test-name-pattern=\"one real outcome\" test/runner.test.ts",
    "live:three": "LIVE_OUTCOME_THREE=1 node --test --test-name-pattern=\"three real outcomes\" test/runner.test.ts",
    "live:restart": "LIVE_OUTCOME_RESTART=1 node --test --test-name-pattern=\"fresh process resumes real outcome\" test/runner.test.ts",
    "live:portable": "LIVE_OUTCOME_PORTABLE=1 node --test --test-name-pattern=\"real portable copy\" test/runner.test.ts",
    "live:claude-transport": "LIVE_OUTCOME_CLAUDE_TRANSPORT=1 node --test test/runner-claude.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
